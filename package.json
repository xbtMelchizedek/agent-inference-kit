  "author": "xbtMelchizedek",
  "license": "MIT",
  "type": "module",
  "exports": { ".": "./src/index.mjs", "./kit.json": "./kit.json", "./package.json": "./package.json" },
  "bin": { "agent-inference-kit": "src/cli.mjs" },
  "files": ["src", "kit.json", "README.md", "CHANGELOG.md", "LICENSE"],
